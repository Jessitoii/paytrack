# PayTrack Environment Configuration
# The PayTrack mobile application is offline-first and runs 100% locally with SQLite (expo-sqlite).

# ==============================================================================
# SERVERLESS SECRETS (SERVER-SIDE ONLY — NEVER EXPOSE TO CLIENT BUNDLE)
# ==============================================================================
# GoCardless Bank Account Data API Credentials (User Secrets)
# Obtain from: https://bankaccountdata.gocardless.com/
#
# CRITICAL SECURITY RULE:
# NEVER prefix these with EXPO_PUBLIC_!
# These must ONLY be configured in your serverless platform (e.g., Vercel Project Settings > Environment Variables).
GC_SECRET_ID=""
GC_SECRET_KEY=""
GC_REDIRECT_URI="https://your-serverless-domain.vercel.app/api/bank/callback"

# Bank Provider Mode: "auto" (default) | "gocardless" | "mock"
# In development, "auto" uses Mock data if secrets are empty, or GoCardless if secrets are provided.
# In production, GoCardless is strictly enforced.
BANK_PROVIDER_MODE="auto"

# ==============================================================================
# CLIENT-SAFE CONFIGURATION (EXPO MOBILE APPLICATION BUNDLE)
# ==============================================================================
# HTTPS URL pointing to your deployed Serverless Functions
EXPO_PUBLIC_API_URL="https://your-serverless-domain.vercel.app"

# Google Cloud OAuth Configuration (Public Client IDs only — No secrets required)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="YOUR_WEB_CLIENT_ID.apps.googleusercontent.com"
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID="YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com"

# Optional: Environment mode
NODE_ENV="development"

# Optional: Headless Browser Paths (for scripts/generate-screenshots.ts only)
# CHROME_BIN="C:\Program Files\Google\Chrome\Application\chrome.exe"
# EDGE_BIN="C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe"
