datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------------------------
// 1. User & Employment Domain
// ----------------------------------------------------------------------

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  timezone       String   @default("Europe/Amsterdam")
  currency       String   @default("EUR")
  initialSavings Decimal  @default(0.00)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employments       Employment[]
  shifts            Shift[]
  workSessions      WorkSession[]
  payrollWeeks      PayrollWeek[]
  payslips          Payslip[]
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  savingsGoals      SavingsGoal[]
  customCategories  ExpenseCategory[]

  @@map("users")
}

model Employer {
  id        String   @id @default(cuid())
  name      String   // e.g. "Albert Heijn B.V. Bleiswijk"
  agency    String?  // e.g. "Carrière Personeelsdiensten B.V."
  country   String   @default("NL")
  createdAt DateTime @default(now())

  employments Employment[]

  @@map("employers")
}

model Employment {
  id          String    @id @default(cuid())
  userId      String
  employerId  String
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  employer              Employer               @relation(fields: [employerId], references: [id], onDelete: Restrict)
  payrollConfigurations PayrollConfiguration[]
  shifts                Shift[]
  payrollWeeks          PayrollWeek[]
  payslips              Payslip[]

  @@index([userId, isActive])
  @@map("employments")
}

// ----------------------------------------------------------------------
// 2. Versioned Payroll Configuration
// ----------------------------------------------------------------------

model PayrollConfiguration {
  id                          String    @id @default(cuid())
  employmentId                String
  name                        String    // e.g. "Carrière AH (Weeks 1-12 2026)"
  effectiveFromDate           DateTime
  effectiveUntilDate          DateTime?
  effectiveFromWeek           Int       // e.g. 1
  effectiveUntilWeek          Int?      // e.g. 12
  
  // Wages & Rates
  baseHourlyRate              Decimal   // e.g. 14.99
  advHourlyRate               Decimal?  // e.g. 1.35
  advPercentage               Decimal?  // e.g. 9.005
  holidayAllowancePercentage  Decimal   @default(8.00)
  holidayEntitlementPercentage Decimal  @default(10.49777)

  // Deductions (%)
  pawwRatePercentage          Decimal   @default(0.1000)
  azvRatePercentage           Decimal   @default(0.7000)
  stippRatePercentage         Decimal   @default(7.5000)
  stippHourlyFranchise        Decimal?
  wgaRatePercentage           Decimal   @default(0.4050)

  // Net Fixed Deductions (Weekly)
  healthInsuranceWeekly       Decimal   @default(38.01)
  additionalInsuranceWeekly   Decimal   @default(2.76)

  // Tax Estimation Mode
  taxEstimationMode           String    @default("CONFIGURABLE_RATE") // CONFIGURABLE_RATE, CUSTOM_ESTIMATE
  estimatedTaxRatePercentage  Decimal?  @default(18.00)
  isDefault                   Boolean   @default(false)
  createdAt                   DateTime  @default(now())

  employment           Employment           @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  payrollCalculations  PayrollCalculation[]

  @@index([employmentId, effectiveFromWeek])
  @@map("payroll_configurations")
}

// ----------------------------------------------------------------------
// 3. Shift Planning & Live Work Tracking
// ----------------------------------------------------------------------

model Shift {
  id           String    @id @default(cuid())
  userId       String
  employmentId String
  date         DateTime  // Shift date (midnight UTC/local)
  shiftType    String    // MORNING, AFTERNOON, NIGHT, OFF, CUSTOM
  plannedStart DateTime?
  plannedEnd   DateTime?
  isDayOff     Boolean   @default(false)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  employment   Employment    @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  workSessions WorkSession[]

  @@index([userId, date])
  @@index([userId, date, shiftType])
  @@map("shifts")
}

model WorkSession {
  id             String    @id @default(cuid())
  userId         String
  shiftId        String?
  actualStart    DateTime
  rawFinish      DateTime? // Original recorded timestamp (NEVER overwritten)
  roundedFinish  DateTime? // 5-minute upward rounded finish timestamp
  elapsedMinutes Int       @default(0) // Derived/cached value; source of truth is actualStart/roundedFinish
  paidMinutes    Int       @default(0) // Derived/cached value; source of truth is elapsed - unpaid breaks
  status         String    @default("COMPLETED") // WORKING, COMPLETED, EDITED, CANCELLED
  isManualEntry  Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift  Shift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  breaks WorkBreak[]

  @@index([userId, actualStart])
  @@map("work_sessions")
}

model WorkBreak {
  id              String       @id @default(cuid())
  workSessionId   String
  type            String       // PAID_15, UNPAID_30, PAID_15_EXTRA, CUSTOM
  durationMinutes Int
  isPaid          Boolean
  startTime       DateTime?
  endTime         DateTime?
  name            String?

  workSession WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)

  @@index([workSessionId])
  @@map("work_breaks")
}

// ----------------------------------------------------------------------
// 4. Weekly Payroll & Calculation Breakdown
// ----------------------------------------------------------------------

model PayrollWeek {
  id           String   @id @default(cuid())
  userId       String
  employmentId String
  year         Int      // e.g. 2026
  weekNumber   Int      // e.g. 33
  startDate    DateTime
  endDate      DateTime
  status       String   @default("OPEN") // OPEN, ESTIMATED, PAID
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  employment  Employment          @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  calculation PayrollCalculation?
  payslip     Payslip?

  @@unique([userId, year, weekNumber])
  @@index([userId, year, weekNumber])
  @@map("payroll_weeks")
}

model PayrollCalculation {
  id                         String   @id @default(cuid())
  payrollWeekId              String   @unique
  payrollConfigId            String?
  configSnapshotJson         String   // IMMUTABLE JSON snapshot of all rules at calculation time
  
  // Hours & Gross
  paidMinutes                Int
  paidHours                  Decimal
  baseHourlyRate             Decimal
  baseGross                  Decimal
  advAllowance               Decimal
  holidayAllowance           Decimal
  holidayEntitlementAccrual  Decimal
  holidayDaysExchange        Decimal  @default(0.00)
  etExchangeDeduction        Decimal  @default(0.00)
  totalGross                 Decimal

  // Deductions & Bases
  pawwDeduction              Decimal
  azvDeduction               Decimal
  stippDeduction             Decimal
  wgaDeduction               Decimal
  totalPayrollDeductions     Decimal
  loonSv                     Decimal  // Taxable base

  // Tax
  estimatedTax               Decimal
  taxAccuracy                String   @default("ESTIMATED") // ESTIMATED, EXACT

  // Net Adjustments
  netBeforeAdjustments       Decimal
  etExchangeReimbursement    Decimal  @default(0.00)
  healthInsurance            Decimal
  additionalInsurance        Decimal
  estimatedNet               Decimal
  estimatedBankPayment       Decimal

  calculatedAt               DateTime @default(now())

  payrollWeek   PayrollWeek                 @relation(fields: [payrollWeekId], references: [id], onDelete: Cascade)
  payrollConfig PayrollConfiguration?       @relation(fields: [payrollConfigId], references: [id], onDelete: SetNull)
  components    PayrollCalculationComponent[]

  @@map("payroll_calculations")
}

model PayrollCalculationComponent {
  id              String   @id @default(cuid())
  calculationId   String
  category        String   // GROSS, PREMIUM, DEDUCTION, TAX, NET_ADJUSTMENT
  code            String   // BASE, ADV, HOLIDAY_8, PAWW, AZV, STIPP, WGA, ZZ, etc.
  name            String
  rateMultiplier  Decimal?
  ratePercentage  Decimal?
  baseAmount      Decimal?
  minutes         Int?
  amount          Decimal
  accuracy        String   @default("EXACT") // EXACT, ESTIMATED

  calculation PayrollCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  @@index([calculationId, category])
  @@map("payroll_calculation_components")
}

// ----------------------------------------------------------------------
// 5. Authoritative Payslips & AI Extraction
// ----------------------------------------------------------------------

model Payslip {
  id             String    @id @default(cuid())
  userId         String
  employmentId   String
  payrollWeekId  String?   @unique
  filePath       String    // Local file path / S3 bucket key
  fileName       String
  fileSizeBytes  Int
  fileHash       String    // SHA-256 for duplicate detection
  parsingStatus  String    @default("PENDING") // PENDING, PARSED, REVIEWED, CONFIRMED, FAILED
  
  // Extracted authoritative totals
  periodStart    DateTime
  periodEnd      DateTime
  totalGross     Decimal
  totalNet       Decimal
  bankPayment    Decimal

  rawAiOutputJson String?  // Unmodified AI JSON output
  userEditedJson  String?  // Changes made during review
  importedAt      DateTime @default(now())
  confirmedAt     DateTime?

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  employment Employment         @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  payrollWeek PayrollWeek?      @relation(fields: [payrollWeekId], references: [id], onDelete: SetNull)
  components PayslipComponent[]

  @@index([userId, fileHash])
  @@index([userId, periodStart])
  @@map("payslips")
}

model PayslipComponent {
  id         String   @id @default(cuid())
  payslipId  String
  category   String   // GROSS, DEDUCTION, TAX, ADJUSTMENT, ACCRUAL
  code       String?
  name       String
  baseAmount Decimal?
  rate       Decimal?
  amount     Decimal

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
  @@map("payslip_components")
}

// ----------------------------------------------------------------------
// 6. Personal Finance (Expenses & Savings Goals)
// ----------------------------------------------------------------------

model ExpenseCategory {
  id        String   @id @default(cuid())
  userId    String?  // null = default system category, non-null = user custom category
  name      String   // Housing, Food, Transportation, Health, etc.
  icon      String?
  color     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, name])
  @@map("expense_categories")
}

model Expense {
  id                  String   @id @default(cuid())
  userId              String
  categoryId          String
  amount              Decimal
  date                DateTime
  description         String
  merchant            String?
  isRecurringInstance Boolean  @default(false)
  recurringExpenseId  String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         ExpenseCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, categoryId])
  @@map("expenses")
}

model RecurringExpense {
  id          String    @id @default(cuid())
  userId      String
  categoryId  String
  name        String    // e.g. "Rent", "Phone Plan", "Health Insurance"
  amount      Decimal
  frequency   String    // WEEKLY, MONTHLY, YEARLY
  dayOfMonth  Int?      // 1-31
  dayOfWeek   Int?      // 0-6
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  expenses Expense[]

  @@index([userId, isActive])
  @@map("recurring_expenses")
}

model SavingsGoal {
  id            String    @id @default(cuid())
  userId        String
  name          String    // e.g. "Emergency Fund", "Travel"
  targetAmount  Decimal
  currentAmount Decimal   @default(0.00)
  targetDate    DateTime?
  color         String?
  icon          String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("savings_goals")
}
